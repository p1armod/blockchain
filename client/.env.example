# ==============================================================================
# E-LAND RECORDS SYSTEM - CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' in the 'client/' directory:
#   cp .env.example .env.local
# Fill in your own credentials below. DO NOT commit .env.local to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MANDATORY)
# Replace with your MongoDB Atlas connection string (or local mongodb://localhost:27017/elandrecords)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/elandrecords?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. INTERNAL API AND BLOCKCHAIN BRIDGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FABRIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. IPFS STORAGE (PINATA CLOUD)
# Free account at https://pinata.cloud (1GB free storage)
# If left empty, system uses simulated IPFS hashes for local development
# ------------------------------------------------------------------------------
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_token_here

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP NOTIFICATIONS (OTP VERIFICATION)
# For Gmail: Use Gmail App Password (16 characters)
# For testing: Use Mailtrap (https://mailtrap.io)
# If left unconfigured, OTP will be printed directly in the server console & API response
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_PASS=your_16_char_app_password
SMTP_FROM="E-Land Records" <noreply@elandrecords.local>

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
